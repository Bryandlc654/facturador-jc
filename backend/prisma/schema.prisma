generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id           Int        @id @default(autoincrement())
  email        String     @unique
  password     String
  nombre       String
  apellido     String
  role         String     @default("USER")
  activo       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  clientes     Cliente[]
  productos    Producto[]
  facturas     Factura[]
}

model Cliente {
  id                      Int         @id @default(autoincrement())
  userId                  Int
  tipo_de_documento       String      @default("6")
  numero_de_documento     String
  denominacion            String
  direccion               String?
  email                   String?
  telefono                String?
  createdAt               DateTime    @default(now())
  updatedAt               DateTime    @updatedAt
  user                    User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facturas                Factura[]

  @@unique([userId, numero_de_documento])
}

model Producto {
  id                  Int         @id @default(autoincrement())
  userId              Int
  codigo              String
  codigo_producto_sunat String?   @default("10000000")
  descripcion         String
  unidad_de_medida    String      @default("NIU")
  valor_unitario      Decimal     @db.Decimal(12, 2)
  precio_unitario     Decimal     @db.Decimal(12, 2)
  tipo_de_igv         Int         @default(1)
  stock               Int         @default(0)
  activo              Boolean     @default(true)
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  user                User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  facturaItems        FacturaItem[]
}

model Factura {
  id                          Int           @id @default(autoincrement())
  userId                      Int
  clienteId                   Int
  operacion                   String
  tipo_de_comprobante         Int           @default(1)
  serie                       String
  numero                      Int
  sunat_transaction           Int           @default(1)
  fecha_de_emision            DateTime
  fecha_de_vencimiento        DateTime?
  moneda                      Int           @default(1)
  tipo_de_cambio              Decimal?      @db.Decimal(4, 3)
  porcentaje_de_igv           Decimal       @default(18.00) @db.Decimal(4, 2)
  descuento_global            Decimal?      @db.Decimal(12, 2)
  total_descuento             Decimal?      @db.Decimal(12, 2)
  total_gravada               Decimal       @db.Decimal(12, 2)
  total_inafecta              Decimal?      @db.Decimal(12, 2)
  total_exonerada             Decimal?      @db.Decimal(12, 2)
  total_igv                   Decimal       @db.Decimal(12, 2)
  total_otros_cargos          Decimal?      @db.Decimal(12, 2)
  total                       Decimal       @db.Decimal(12, 2)
  observaciones               String?
  condiciones_de_pago         String?
  medio_de_pago               String?
  formato_de_pdf              String?       @default("A4")
  enlace                      String?
  enlace_del_pdf              String?
  enlace_del_xml              String?
  enlace_del_cdr              String?
  aceptada_por_sunat          Boolean       @default(false)
  sunat_description           String?
  sunat_responsecode          String?
  codigo_hash                 String?
  cadena_para_codigo_qr       String?
  anulado                     Boolean       @default(false)
  motivo_anulacion            String?
  fecha_anulacion             DateTime?
  createdAt                   DateTime      @default(now())
  updatedAt                   DateTime      @updatedAt
  user                        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  cliente                     Cliente       @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  items                       FacturaItem[]

  @@unique([userId, tipo_de_comprobante, serie, numero])
}

model FacturaItem {
  id                      Int         @id @default(autoincrement())
  facturaId               Int
  productoId              Int
  unidad_de_medida        String      @default("NIU")
  codigo                  String
  codigo_producto_sunat   String?
  descripcion             String
  cantidad                Decimal     @db.Decimal(12, 2)
  valor_unitario          Decimal     @db.Decimal(12, 2)
  precio_unitario         Decimal     @db.Decimal(12, 2)
  descuento               Decimal?    @db.Decimal(12, 2)
  subtotal                Decimal     @db.Decimal(12, 2)
  tipo_de_igv             Int         @default(1)
  igv                     Decimal     @db.Decimal(12, 2)
  total                   Decimal     @db.Decimal(12, 2)
  factura                 Factura     @relation(fields: [facturaId], references: [id], onDelete: Cascade)
  producto                Producto    @relation(fields: [productoId], references: [id], onDelete: Cascade)
}
